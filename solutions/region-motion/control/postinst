#!/bin/sh

echo "Installing Region Motion Detection..."

mkdir -p /userdata/local/apps

chmod +x /usr/local/bin/region-motion
chmod +x /etc/init.d/K92region-motion 2>/dev/null || true

APPS_DIR=/userdata/local/apps
SHARE_DIR=/usr/share/region-motion
for f in region-motion.json region-motion.md region-motion.zh.md; do
    if [ -f "$SHARE_DIR/$f" ]; then
        cp -f "$SHARE_DIR/$f" "$APPS_DIR/$f"
    else
        echo "WARNING: $SHARE_DIR/$f missing, not registered"
    fi
done
echo "App manifest installed: $APPS_DIR/region-motion.json"

echo "Region Motion Detection installed successfully!"
echo ""
echo "Detection settings: console app page, or"
echo "  /userdata/local/apps/region-motion.config.json"
echo "Configuration file: /etc/region-motion.conf"
echo ""
echo "RTSP stream:     rtsp://<device_ip>:8554/live0"
echo "MQTT topic:      recamera/region-motion/results"
echo "Debug WebSocket: ws://<device_ip>:8001/ (video), ws://<device_ip>:8001/results"

rm -f /etc/init.d/S92region-motion

exit 0
