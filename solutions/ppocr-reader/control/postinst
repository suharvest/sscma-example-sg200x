#!/bin/sh

# Post-installation script for ppocr-reader

echo "Installing PP-OCR Reader Application..."

# Create data directories if not exists
mkdir -p /userdata/local/models
mkdir -p /userdata/local/dict
mkdir -p /userdata/local/apps

# Set permissions
chmod +x /usr/local/bin/ppocr-reader
chmod +x /etc/init.d/K92ppocr-reader 2>/dev/null || true

# Register with the supervisor app gallery (vendor path):
# third-party app debs ship their own manifest + integration docs and
# install them into /userdata/local/apps/, which the supervisor scans
# (user manifests there override built-ins with the same id).
APPS_DIR=/userdata/local/apps
SHARE_DIR=/usr/share/ppocr-reader
for f in ppocr-reader.json ppocr-reader.md ppocr-reader.zh.md; do
    if [ -f "$SHARE_DIR/$f" ]; then
        cp -f "$SHARE_DIR/$f" "$APPS_DIR/$f"
    fi
done
echo "App manifest installed: $APPS_DIR/ppocr-reader.json"

echo "PP-OCR Reader installed successfully!"
echo ""
echo "Usage: ppocr-reader [options]"
echo "       ppocr-reader --help for more options"
echo ""
echo "Before starting, copy the pipeline models and dictionary to the device:"
echo "  /userdata/local/models/ppocr_det_cv181x_mix.cvimodel"
echo "  /userdata/local/models/ppocr_rec_cv181x_bf16.cvimodel"
echo "  /userdata/local/dict/ppocr_keys_v1.txt"
echo ""
echo "Configuration file: /etc/ppocr-reader.conf"
echo ""
echo "RTSP stream:     rtsp://<device_ip>:8554/live0"
echo "MQTT topic:      recamera/ppocr/texts"
echo "Debug WebSocket: ws://<device_ip>:8001/ (video), ws://<device_ip>:8001/results"

# Migration: remove the auto-start (S-prefixed) script from older package
# layouts. Gallery apps must NOT start at boot — only the supervisor's
# app_restore starts the single active application (K-prefix is skipped
# by SysVinit but still invocable by path).
rm -f /etc/init.d/S92ppocr-reader

exit 0
