#!/bin/sh

# Pre-removal script for ppocr-reader

echo "Removing PP-OCR Reader Application..."

# Stop the service if running
for script in /etc/init.d/[SK]92ppocr-reader; do
    [ -x "$script" ] && "$script" stop 2>/dev/null || true
done
pkill -f /usr/local/bin/ppocr-reader 2>/dev/null || true

echo "PP-OCR Reader removed."

exit 0
