{
    "id": "ppocr-reader",
    "name": "PP-OCR Text Reader",
    "name_zh": "PP-OCR 文字识别",
    "scene": "General",
    "description": "On-device scene text reading with a fixed two-model PP-OCRv3 pipeline: DBNet text detection plus SVTR-LCNet recognition (6623 characters, Chinese + English). Publishes recognized texts over MQTT and streams H.264 via RTSP.",
    "type": "native",
    "init_script": "/etc/init.d/K92ppocr-reader",
    "rtsp_url": "rtsp://{host}:8554/live0",
    "mqtt_topic": "recamera/ppocr/texts",
    "debug_ws": {
        "port": 8001,
        "video_path": "/",
        "results_path": "/results"
    },
    "models": [],
    "pipeline": [
        {
            "name": "ppocr-det",
            "path": "/userdata/local/models/ppocr_det_cv181x_mix.cvimodel",
            "task": "text-detect"
        },
        {
            "name": "ppocr-rec",
            "path": "/userdata/local/models/ppocr_rec_cv181x_bf16.cvimodel",
            "task": "text-recognize"
        }
    ],
    "version": "0.4.0",
    "author": "Seeed Studio"
}
