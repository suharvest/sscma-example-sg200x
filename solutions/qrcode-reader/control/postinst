#!/bin/sh

# Post-installation script for qrcode-reader

echo "Installing QR Code Reader..."

# Create data directories if not exists
mkdir -p /userdata/local/models
mkdir -p /userdata/local/apps

# Set permissions
chmod +x /usr/local/bin/qrcode-reader
chmod +x /etc/init.d/K92qrcode-reader 2>/dev/null || true

# Register with the supervisor app gallery (vendor path):
# app debs ship their own manifest + integration docs and install them into
# /userdata/local/apps/, which the supervisor scans (user manifests there
# override built-ins with the same id).
APPS_DIR=/userdata/local/apps
SHARE_DIR=/usr/share/qrcode-reader
for f in qrcode-reader.json qrcode-reader.md qrcode-reader.zh.md; do
    if [ -f "$SHARE_DIR/$f" ]; then
        cp -f "$SHARE_DIR/$f" "$APPS_DIR/$f"
    fi
done
echo "App manifest installed: $APPS_DIR/qrcode-reader.json"

echo "QR Code Reader installed successfully!"
echo ""
echo "Configuration file: /etc/qrcode-reader.conf"
echo ""
echo "RTSP stream:     rtsp://<device_ip>:8554/live0"
echo "MQTT topic:      recamera/qrcode-reader/results"
echo "Debug WebSocket: ws://<device_ip>:8001/ (video), ws://<device_ip>:8001/results"

# Migration: remove the auto-start (S-prefixed) script from older package
# layouts. Gallery apps must NOT start at boot — only the supervisor's
# app_restore starts the single active application (K-prefix is skipped
# by SysVinit but still invocable by path).
rm -f /etc/init.d/S92qrcode-reader

exit 0
