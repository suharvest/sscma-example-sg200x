{
  "id": "retail-vision",
  "name": "Retail People Counting",
  "name_zh": "零售人流分析",
  "scene": "Retail",
  "scene_zh": "零售",
  "description": "Answers the three questions every store manager asks: how many customers came in, where do they linger, and who needs help right now? Automatic entry/exit counting plus browsing / engaged / assistance states put numbers behind staffing, displays and layout decisions.",
  "description_zh": "回答门店经营最关心的三件事：今天来了多少客人？他们在哪儿停留？谁正需要帮助？自动统计进出客流、区分浏览/驻足/求助状态，让排班、陈列和动线调整有数可依。",
  "type": "native",
  "init_script": "/etc/init.d/K92retail-vision",
  "image": "/apps/retail-vision.png",
  "rtsp_url": "rtsp://{host}:8554/live0",
  "mqtt_topic": "recamera/retail-vision/vision",
  "debug_ws": {
    "port": 8001,
    "video_path": "/",
    "results_path": "/results"
  },
  "privacy_blur": true,
  "models": [
    {
      "name": "yolo11n",
      "path": "/userdata/local/models/yolo11n_detection_cv181x_int8.cvimodel",
      "task": "detect"
    }
  ],
  "default_model": "yolo11n",
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "title": "Confidence threshold",
            "title_zh": "置信度阈值",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          }
        ]
      },
      {
        "key": "zone",
        "title": "Counting Zone",
        "title_zh": "统计区域",
        "items": [
          {
            "key": "count_zone",
            "type": "zone",
            "title": "Counting zone",
            "title_zh": "统计区域",
            "maxPoints": 8
          }
        ]
      },
      {
        "key": "line",
        "title": "Entry / Exit Line",
        "title_zh": "进出计数线",
        "items": [
          {
            "key": "entry_line",
            "type": "line",
            "title": "Entry line",
            "title_zh": "进出计数线",
            "directional": true
          }
        ]
      },
      {
        "key": "dwell",
        "title": "Dwell",
        "title_zh": "驻留",
        "items": [
          {
            "key": "dwell_engaged",
            "type": "number",
            "title": "Engaged threshold (s)",
            "title_zh": "驻足阈值（秒）",
            "min": 0.5,
            "max": 30,
            "step": 0.5,
            "default": 1.5
          },
          {
            "key": "dwell_assist",
            "type": "number",
            "title": "Assistance threshold (s)",
            "title_zh": "求助阈值（秒）",
            "min": 5,
            "max": 120,
            "step": 1,
            "default": 20
          },
          {
            "key": "dwell_speed",
            "type": "number",
            "title": "Stationary speed (px/s)",
            "title_zh": "驻留速度阈值（像素/秒）",
            "min": 1,
            "max": 50,
            "step": 1,
            "default": 10
          }
        ]
      },
      {
        "key": "window",
        "title": "Window",
        "title_zh": "统计窗口",
        "items": [
          {
            "key": "window_duration",
            "type": "number",
            "title": "Rolling window (s)",
            "title_zh": "滚动窗口（秒）",
            "min": 10,
            "max": 600,
            "step": 10,
            "default": 60
          },
          {
            "key": "person_height",
            "type": "number",
            "title": "Avg person height (m)",
            "title_zh": "平均身高（米）",
            "min": 1.0,
            "max": 2.2,
            "step": 0.1,
            "default": 1.7
          }
        ]
      }
    ]
  },
  "version": "1.4.0",
  "author": "Seeed Studio"
}
