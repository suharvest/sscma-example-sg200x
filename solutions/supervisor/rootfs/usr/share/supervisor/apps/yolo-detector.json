{
    "id": "yolo-detector",
    "name": "Object Detection",
    "name_zh": "通用目标检测",
    "scene": "General",
    "description": "General-purpose YOLO object detection. Publishes detection results over MQTT and streams H.264 via RTSP. Supports switching between detection models.",
    "type": "native",
    "init_script": "/etc/init.d/S92yolo-detector",
    "rtsp_url": "rtsp://{host}:8554/live0",
    "mqtt_topic": "recamera/yolo-detector/results",
    "debug_ws": {
        "port": 8001,
        "video_path": "/",
        "results_path": "/results"
    },
    "models": [
        {
            "name": "yolo11n",
            "path": "/userdata/local/models/yolo11n_detection_cv181x_int8.cvimodel",
            "task": "detect"
        },
        {
            "name": "yolo11n-pose",
            "path": "/userdata/local/models/yolo11n_pose_cv181x_int8.cvimodel",
            "task": "pose"
        },
        {
            "name": "yolo26n",
            "path": "/userdata/local/models/yolo26n_cv181x_int8.cvimodel",
            "task": "detect"
        }
    ],
    "default_model": "yolo11n",
    "config_schema": {
        "groups": [
            {
                "key": "detection",
                "title": "Detection",
                "title_zh": "检测",
                "items": [
                    {
                        "key": "confidence",
                        "type": "number",
                        "title": "Confidence threshold",
                        "title_zh": "置信度阈值",
                        "min": 0.05,
                        "max": 0.95,
                        "step": 0.05,
                        "default": 0.25
                    },
                    {
                        "key": "tracking",
                        "type": "boolean",
                        "title": "Person tracking",
                        "title_zh": "人员追踪",
                        "default": true
                    }
                ]
            },
            {
                "key": "spatial",
                "title": "Zones & Lines",
                "title_zh": "区域与划线",
                "items": [
                    {
                        "key": "count_zone",
                        "type": "zone",
                        "title": "Counting zone",
                        "title_zh": "统计区域",
                        "maxPoints": 8
                    },
                    {
                        "key": "entry_line",
                        "type": "line",
                        "title": "Entry line",
                        "title_zh": "进出计数线",
                        "directional": true
                    }
                ]
            }
        ]
    },
    "version": "1.1.0",
    "author": "Seeed Studio"
}
