#!/bin/sh
set -e

# Gallery mode: persistently disable services that conflict with gallery apps
# over the camera (VPSS is single-owner). Idempotent: only renames if the
# S-prefixed script exists.
#
# To restore the factory behavior (re-enable Node-RED / sscma-node), run:
#   mv /etc/init.d/K03node-red /etc/init.d/S03node-red
#   mv /etc/init.d/K91sscma-node /etc/init.d/S91sscma-node
#   reboot
disable_service() {
    name="$1" # e.g. S03node-red
    kname="K${name#S}"
    if [ -f "/etc/init.d/$name" ]; then
        "/etc/init.d/$name" stop >/dev/null 2>&1 || true
        mv "/etc/init.d/$name" "/etc/init.d/$kname" || true
    fi
}

# Run-mode aware (P4-D): only park the services when the device is in console
# mode (the factory default; a missing/unreadable mode file means console).
# In Node-RED mode a supervisor upgrade must NOT take down the user's flows.
RUN_MODE="$(head -n 1 /userdata/local/apps/mode 2>/dev/null | tr -d ' \t\r\n')" || true
[ "$RUN_MODE" = "nodered" ] || RUN_MODE=console
if [ "$RUN_MODE" = "console" ]; then
    disable_service S03node-red
    disable_service S91sscma-node
fi

# USB gadget DHCP fix: the factory dnsmasq configs advertise the camera as
# the host's default gateway (option 3). The USB link has no upstream, so
# Mac/Windows hosts lose internet whenever the camera is plugged in. An empty
# option value tells dnsmasq to suppress it; the host keeps a subnet route
# (SSH/Web/RTSP unaffected) and its default route stays on Wi-Fi. Idempotent.
DNSMASQ_FIXED=0
for f in /etc/dnsmasq/usb_only.conf /etc/dnsmasq/usb_wlan1.conf; do
    if [ -f "$f" ] && grep -q '^dhcp-option=set:usb0,3,' "$f"; then
        sed -i 's|^dhcp-option=set:usb0,3,.*|dhcp-option=set:usb0,3 # suppress gateway: USB link is host-local|' "$f"
        DNSMASQ_FIXED=1
    fi
done
if [ "$DNSMASQ_FIXED" = "1" ] && [ -f /etc/init.d/S80dnsmasq ]; then
    /etc/init.d/S80dnsmasq stop >/dev/null 2>&1 || true
    sleep 1
    /etc/init.d/S80dnsmasq start >/dev/null 2>&1 || true
fi

if [ -f /etc/init.d/S93sscma-supervisor ]; then
    /etc/init.d/S93sscma-supervisor start
fi


exit 0
