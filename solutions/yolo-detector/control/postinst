#!/bin/sh

# Post-installation script for yolo-detector

echo "Installing YOLO Detector Application..."

# Create model directories if not exists
mkdir -p /userdata/local/models
mkdir -p /userdata/local/apps

# Set permissions
chmod +x /usr/local/bin/yolo-detector
chmod +x /etc/init.d/K92yolo-detector 2>/dev/null || true

echo "YOLO Detector installed successfully!"
echo ""
echo "Usage: yolo-detector [options]"
echo "       yolo-detector --help for more options"
echo ""
echo "Models should be placed in: /userdata/local/models/"
echo "Model override (managed by the supervisor console):"
echo "  /userdata/local/apps/yolo-detector.model"
echo ""
echo "Configuration file: /etc/yolo-detector.conf"
echo ""
echo "RTSP stream:     rtsp://<device_ip>:8554/live0"
echo "MQTT topic:      recamera/yolo-detector/results"
echo "Debug WebSocket: ws://<device_ip>:8001/ (video), ws://<device_ip>:8001/results"

# Migration: remove the auto-start (S-prefixed) script from older package
# layouts. Gallery apps must NOT start at boot — only the supervisor's
# app_restore starts the single active application (K-prefix is skipped
# by SysVinit but still invocable by path).
rm -f /etc/init.d/S92yolo-detector

exit 0
