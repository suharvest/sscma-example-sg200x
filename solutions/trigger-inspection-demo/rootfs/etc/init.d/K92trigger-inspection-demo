#!/bin/sh

### BEGIN INIT INFO
# Provides:          trigger-inspection-demo
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Trigger-only station inspection
### END INIT INFO

NAME=trigger-inspection-demo
DAEMON=/usr/local/bin/trigger-inspection-demo
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log

export LD_LIBRARY_PATH=/usr/lib/trigger-inspection-demo:/mnt/system/lib:/mnt/system/usr/lib:/mnt/system/usr/lib/3rd:/mnt/system/lib/3rd:/lib:/usr/lib

DAEMON_OPTS="-v"

# Load global reCamera config (MQTT_HOST, MQTT_PORT, etc.)
[ -f /etc/recamera.conf ] && . /etc/recamera.conf

# Load solution-specific config (can override global settings)
[ -f /etc/trigger-inspection-demo.conf ] && . /etc/trigger-inspection-demo.conf

# Apply MQTT settings from config
[ -n "$MQTT_HOST" ] && DAEMON_OPTS="$DAEMON_OPTS --mqtt-host $MQTT_HOST"
[ -n "$MQTT_PORT" ] && DAEMON_OPTS="$DAEMON_OPTS --mqtt-port $MQTT_PORT"

MQTT_TOPIC="${MQTT_TOPIC:-recamera/trigger-inspection-demo/results}"
DAEMON_OPTS="$DAEMON_OPTS --mqtt-topic $MQTT_TOPIC"

# Debug stream settings
# Streams are off by default (StreamMode::None); DEBUG_ENABLED=1 turns on the WebSocket preview.
[ "$DEBUG_ENABLED" = "1" ] && DAEMON_OPTS="$DAEMON_OPTS --debug"
[ "$DEBUG_ENABLED" = "0" ] && DAEMON_OPTS="$DAEMON_OPTS --no-debug"
[ -n "$DEBUG_PORT" ] && DAEMON_OPTS="$DAEMON_OPTS --debug-port $DEBUG_PORT"

# Trigger settings (see /usr/share/trigger-inspection-demo/trigger-inspection-demo.md)
[ -n "$HTTP_PORT" ] && DAEMON_OPTS="$DAEMON_OPTS --http-port $HTTP_PORT"
[ -n "$GPIO_LINE" ] && DAEMON_OPTS="$DAEMON_OPTS --gpio $GPIO_LINE"
[ -n "$GPIO_EDGE" ] && DAEMON_OPTS="$DAEMON_OPTS --gpio-edge $GPIO_EDGE"
[ "$GPIO_ACTIVE_LOW" = "1" ] && DAEMON_OPTS="$DAEMON_OPTS --gpio-active-low"
[ -n "$IDLE_FPS" ] && DAEMON_OPTS="$DAEMON_OPTS --idle-fps $IDLE_FPS"
# Anything else (ROI, thresholds, --rtsp ...), passed through verbatim
[ -n "$EXTRA_OPTS" ] && DAEMON_OPTS="$DAEMON_OPTS $EXTRA_OPTS"

# Stop conflicting services that use the camera.
# NOTE: the supervisor is deliberately NOT stopped here — it is the app
# manager that orchestrates starting/stopping this service.
stop_conflicting_services() {
    echo "Stopping conflicting services..."
    for prefix in S K; do
        [ -x /etc/init.d/${prefix}91sscma-node ] && /etc/init.d/${prefix}91sscma-node stop 2>/dev/null || true
        [ -x /etc/init.d/${prefix}03node-red ] && /etc/init.d/${prefix}03node-red stop 2>/dev/null || true
    done
    for svc in face-analysis detection-blur ppocr-reader retail-vision yolo-detector facemesh-reader weather-classifier fall-detection fitness-trainer depth-estimation region-motion microduck-pose-qa; do
        for script in /etc/init.d/[SK]*${svc}; do
            [ -x "$script" ] && "$script" stop 2>/dev/null || true
        done
    done
    sleep 2
}

start() {
    echo "Starting $NAME..."
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            echo "$NAME is already running (PID: $PID)"
            return 1
        fi
        rm -f $PIDFILE
    fi

    stop_conflicting_services

    start-stop-daemon -S -b -m -p $PIDFILE -a /bin/sh -- -c "exec $DAEMON $DAEMON_OPTS >> $LOGFILE 2>&1"
    if [ $? -ne 0 ]; then
        echo "$NAME failed to start (start-stop-daemon error)"
        rm -f $PIDFILE
        return 1
    fi

    sleep 1
    i=0
    while [ $i -lt 3 ]; do
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -z "$PID" ] || [ ! -d "/proc/$PID" ]; then
            echo "$NAME exited immediately after start"
            rm -f $PIDFILE
            return 1
        fi
        sleep 0.5
        i=$((i + 1))
    done
    echo "OK"
    return 0
}

stop() {
    echo "Stopping $NAME..."
    if [ ! -f $PIDFILE ]; then
        echo "$NAME is not running"
        return 0
    fi
    PID=$(cat $PIDFILE 2>/dev/null)
    if [ -z "$PID" ]; then
        rm -f $PIDFILE
        echo "$NAME is not running"
        return 0
    fi
    start-stop-daemon -K -p $PIDFILE -s TERM 2>/dev/null || true
    i=0
    while [ $i -lt 16 ]; do
        [ -d "/proc/$PID" ] || { rm -f $PIDFILE; echo "OK"; return 0; }
        sleep 0.5
        i=$((i + 1))
    done
    echo "$NAME failed to stop gracefully (PID $PID still alive)"
    return 1
}

restart() {
    stop
    sleep 2
    start
}

status() {
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            echo "$NAME is running (PID: $PID)"
            return 0
        fi
        rm -f $PIDFILE
    fi
    echo "$NAME is not running"
    return 1
}

case "$1" in
    start) start; exit $? ;;
    stop) stop; exit $? ;;
    restart) restart; exit $? ;;
    status) status; exit $? ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit 0
