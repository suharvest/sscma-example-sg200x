#!/bin/sh
set -e

echo "Installing Microduck 17-Keypoint Pose QA package..."

# Create necessary directories
mkdir -p /userdata/local/models
mkdir -p /userdata/local/apps
mkdir -p /usr/share/supervisor/models

# Deploy App Gallery manifest to active supervisor apps directory
if [ -f /usr/share/microduck-pose-qa/microduck-pose-qa.json ]; then
    cp -f /usr/share/microduck-pose-qa/microduck-pose-qa.json /userdata/local/apps/microduck-pose-qa.json
fi

# Ensure executable permissions for init script
if [ -f /etc/init.d/K92microduck-pose-qa ]; then
    chmod 755 /etc/init.d/K92microduck-pose-qa
fi

# Ensure no S-prefixed script exists to avoid camera/VPSS boot conflict
rm -f /etc/init.d/S92microduck-pose-qa

# Ensure model symlinks in supervisor models directory
ln -sf /userdata/local/models/microduck_pose_17kpt_384_int8.cvimodel /usr/share/supervisor/models/microduck_pose_17kpt_384_int8.cvimodel
ln -sf /userdata/local/models/microduck_pose_17kpt_384_int8.json /usr/share/supervisor/models/microduck_pose_17kpt_384_int8.json

# Sync filesystem
sync

echo "Microduck Pose QA installed successfully."
exit 0
