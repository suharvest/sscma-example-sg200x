{
  "id": "microduck-pose-qa",
  "name": "Microduck Pose QA",
  "name_zh": "Microduck 关节姿态质检",
  "scene": "Industrial & Quality Assurance",
  "scene_zh": "工业制造与质检",
  "description": "On-device Microduck 17-keypoint robot pose estimation and automated kinematic quality assurance for reCamera SG2002. Tracks 14 servo joints in real time, detects 14.4-degree gear spline misalignments, verifies bilateral knee symmetry and posture drift.",
  "description_zh": "基于 reCamera SG2002 的 Microduck 17 关键点机器人位姿估计与整机自动化组装质检应用。在设备端实时跟踪 14 个舵机驱动关节，检测 14.4° 齿轮跳齿错位，校验双膝动作对称性与站立回位误差，通过 MQTT 输出结构化质检报告。",
  "type": "native",
  "init_script": "/etc/init.d/K92microduck-pose-qa",
  "image": "/apps/microduck-pose-qa.png",
  "rtsp_url": "rtsp://{host}:8554/live0",
  "mqtt_topic": "recamera/microduck-pose-qa/results",
  "debug_ws": {
    "port": 8001,
    "video_path": "/",
    "results_path": "/results"
  },
  "control_api": {
    "port": 8082,
    "path": "/api/control"
  },
  "models": [
    {
      "name": "microduck-pose-17kpt",
      "path": "/userdata/local/models/microduck_pose_17kpt_384_int8.cvimodel",
      "task": "pose"
    }
  ],
  "default_model": "microduck-pose-17kpt",
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection Thresholds",
        "title_zh": "检测阈值",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "title": "Robot Confidence",
            "title_zh": "机器人检测置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.60
          },
          {
            "key": "keypoint_confidence",
            "type": "number",
            "title": "Keypoint Confidence",
            "title_zh": "关键点置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.35
          }
        ]
      },
      {
        "key": "tolerances",
        "title": "QA Kinematic Tolerances",
        "title_zh": "质检运动学容差",
        "items": [
          {
            "key": "gear_tooth_tolerance_deg",
            "type": "number",
            "title": "Gear Spline Tolerance (deg)",
            "title_zh": "花键错齿角容差（度）",
            "min": 1.0,
            "max": 45.0,
            "step": 0.5,
            "default": 10.0
          },
          {
            "key": "bilateral_height_tolerance_norm",
            "type": "number",
            "title": "Bilateral Height Tolerance (norm)",
            "title_zh": "双膝高度对称容差（归一化）",
            "min": 0.001,
            "max": 0.50,
            "step": 0.005,
            "default": 0.040
          },
          {
            "key": "spine_tilt_tolerance_deg",
            "type": "number",
            "title": "Spine Tilt Tolerance (deg)",
            "title_zh": "躯干脊柱倾角容差（度）",
            "min": 1.0,
            "max": 45.0,
            "step": 0.5,
            "default": 12.0
          }
        ]
      }
    ]
  },
  "version": "1.0.7",
  "author": "Seeed Studio"
}
