#!/bin/sh

# Pre-installation script for fall-detection

# Stop a previously installed instance before upgrading (idempotent)
for script in /etc/init.d/[SK]92fall-detection; do
    [ -x "$script" ] && "$script" stop 2>/dev/null || true
done
pkill -f /usr/local/bin/fall-detection 2>/dev/null || true

exit 0
