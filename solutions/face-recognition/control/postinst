#!/bin/sh

# Post-installation script for face-recognition

echo "Installing Face Recognition Application..."

mkdir -p /userdata/local/models
mkdir -p /userdata/local/face-gallery
mkdir -p /userdata/local/apps

chmod +x /usr/local/bin/face-recognition
chmod +x /etc/init.d/K92face-recognition 2>/dev/null || true

echo "Face Recognition installed successfully!"
echo ""
echo "Usage: face-recognition [options]"
echo "       face-recognition --help for more options"
echo ""
echo "Models should be placed in: /userdata/local/models/"
echo "  - scrfd_500m_int8.cvimodel        (face detection + 5-point landmarks)"
echo "  - arcface_mbf_bf16.cvimodel       (512-D embedding)"
echo "  - liveness_minifasnet_bf16.cvimodel (optional anti-spoof)"
echo ""
echo "Gallery: /userdata/local/face-gallery/cvi_scrfd500m_mbf512_bf16.json"
echo "Configuration file: /etc/face-recognition.conf"
echo ""
echo "RTSP stream: rtsp://<device_ip>:554/live"
echo "MQTT results: recamera/face-recognition/results"
echo "MQTT commands: recamera/face-recognition/cmd -> recamera/face-recognition/cmd/ack"

# Register with the supervisor app gallery. The console scans
# /usr/share/supervisor/apps/ (built-ins) and /userdata/local/apps/ (installed
# apps); /usr/share/face-recognition/ is neither, so the manifest and the
# integration docs have to be copied across or the app never appears.
#
# The manifest travels with the application rather than with the supervisor, so
# the gallery lists exactly what is installed.
APPS_DIR=/userdata/local/apps
SHARE_DIR=/usr/share/face-recognition
mkdir -p "$APPS_DIR"
for f in face-recognition.json face-recognition.md face-recognition.zh.md; do
    if [ -f "$SHARE_DIR/$f" ]; then
        cp -f "$SHARE_DIR/$f" "$APPS_DIR/$f"
    else
        echo "WARNING: $SHARE_DIR/$f missing, not registered"
    fi
done
echo "App manifest installed: $APPS_DIR/face-recognition.json"

# Gallery apps must NOT start at boot: only the supervisor's app_restore starts
# the single active camera application. A K-prefixed script is skipped by
# SysVinit but still invocable by path.
rm -f /etc/init.d/S92face-recognition

exit 0
