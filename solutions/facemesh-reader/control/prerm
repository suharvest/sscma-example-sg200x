#!/bin/sh

# Pre-removal script for facemesh-reader

echo "Removing FaceMesh Reader..."

# Stop the service if running
for script in /etc/init.d/[SK]92facemesh-reader; do
    [ -x "$script" ] && "$script" stop 2>/dev/null || true
done
pkill -f /usr/local/bin/facemesh-reader 2>/dev/null || true

echo "FaceMesh Reader removed."

exit 0
