#!/bin/sh

# Pre-installation script for fitness-trainer

# Stop a previously installed instance before upgrading (idempotent)
for script in /etc/init.d/[SK]92fitness-trainer; do
    [ -x "$script" ] && "$script" stop 2>/dev/null || true
done
pkill -f /usr/local/bin/fitness-trainer 2>/dev/null || true

exit 0
