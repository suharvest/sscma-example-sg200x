{
  "id": "fitness-trainer",
  "name": "Fitness Trainer",
  "name_zh": "健身教练",
  "scene": "Health & Wellness",
  "scene_zh": "健康健身",
  "description": "Counts your reps and calls out sloppy form, on-device. Pick squats, push-ups or hammer curls, set your reps and sets, and the camera does the rest — no phone, no wearable, and no video leaving the device. Live counts stream to Home Assistant for workout logging and automations.",
  "description_zh": "在设备本地数你的组数，并提示动作不到位。选择深蹲、俯卧撑或哑铃弯举，设定次数与组数，剩下的交给摄像头——不用手机、不戴手环，画面也不出设备。计数实时推送到 Home Assistant，可用于训练记录与自动化。",
  "type": "native",
  "init_script": "/etc/init.d/K92fitness-trainer",
  "image": "/apps/fitness-trainer.png",
  "rtsp_url": "rtsp://{host}:8554/live0",
  "mqtt_topic": "recamera/fitness-trainer/results",
  "debug_ws": {
    "port": 8001,
    "video_path": "/",
    "results_path": "/results"
  },
  "models": [
    {
      "name": "yolo11n-pose",
      "path": "/usr/share/supervisor/models/yolo11n_pose_cv181x_int8.cvimodel",
      "task": "pose"
    }
  ],
  "default_model": "yolo11n-pose",
  "config_schema": {
    "groups": [
      {
        "key": "workout",
        "title": "Workout",
        "title_zh": "训练设置",
        "items": [
          {
            "key": "mode",
            "type": "enum",
            "title": "Exercise",
            "title_zh": "运动模式",
            "options": ["squat", "push_up", "hammer_curl"],
            "option_labels": ["Squat", "Push-up", "Hammer Curl"],
            "option_labels_zh": ["深蹲", "俯卧撑", "哑铃弯举"],
            "default": "squat"
          },
          {
            "key": "target_reps",
            "type": "number",
            "title": "Reps per set",
            "title_zh": "每组次数",
            "min": 1,
            "max": 100,
            "step": 1,
            "default": 12
          },
          {
            "key": "target_sets",
            "type": "number",
            "title": "Sets",
            "title_zh": "组数",
            "min": 1,
            "max": 20,
            "step": 1,
            "default": 3
          },
          {
            "key": "idle_reset_seconds",
            "type": "number",
            "title": "Reset after idle (seconds, 0 = never)",
            "title_zh": "无人后重置计数（秒，0 = 不重置）",
            "min": 0,
            "max": 3600,
            "step": 10,
            "default": 60
          }
        ]
      },
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "title": "Person confidence threshold",
            "title_zh": "人体置信度阈值",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "keypoint_confidence",
            "type": "number",
            "title": "Keypoint confidence threshold",
            "title_zh": "关键点置信度阈值",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          }
        ]
      }
    ]
  },
  "version": "0.2.2",
  "author": "Seeed Studio"
}
