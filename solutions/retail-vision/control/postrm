#!/bin/sh

# Post-removal script for retail-vision
#
# Clean up the gallery registration installed by postinst. Trade-off:
# removing the manifest here means the app disappears from the supervisor
# gallery on uninstall (otherwise it would linger as a ghost entry whose
# init_script no longer exists). On upgrade/reinstall opkg runs
# prerm -> postrm -> unpack -> postinst, so postinst re-installs these
# files right after — no data is lost across upgrades. The console-managed
# model override (retail-vision.model) is also removed as it only makes
# sense while the app is installed.

for f in retail-vision.json retail-vision.md retail-vision.zh.md; do
    rm -f "/userdata/local/apps/$f" 2>/dev/null || true
done

# Keep the model override across upgrades; drop it only on real removal.
if [ "$1" != "upgrade" ]; then
    rm -f /userdata/local/apps/retail-vision.model 2>/dev/null || true
fi

exit 0
