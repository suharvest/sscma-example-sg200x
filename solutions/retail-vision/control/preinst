#!/bin/sh

# Pre-installation script for retail-vision

# Stop a previously installed instance before upgrading (idempotent)
for script in /etc/init.d/[SK]92retail-vision; do
    [ -x "$script" ] && "$script" stop 2>/dev/null || true
done
pkill -f /usr/local/bin/retail-vision 2>/dev/null || true

exit 0
