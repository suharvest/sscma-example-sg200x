#!/bin/sh

# Post-installation script for face-analysis

echo "Installing Face Analysis Application..."

# Create models directory if not exists
mkdir -p /userdata/local/models
mkdir -p /userdata/local/apps

# Set permissions
chmod +x /usr/local/bin/face-analysis

echo "Face Analysis installed successfully!"
echo ""
echo "Usage: face-analysis [options]"
echo "       face-analysis --help for more options"
echo ""
echo "Models should be placed in: /userdata/local/models/"
echo "  - yolov8n_face_cv181x_int8.cvimodel (face detection)"
echo "  - fairface_int8.cvimodel (age/gender/race)"
echo "  - enet_b0_8_best_afew_cv181x_bf16.cvimodel (emotion recognition)"
echo ""
echo "Configuration file: /etc/face-analysis.conf"
echo ""
echo "RTSP stream: rtsp://<device_ip>:8554/live0"
echo "MQTT topic: recamera/face-analysis/results"

# Register with the supervisor app gallery. The console scans
# /usr/share/supervisor/apps/ (built-ins) and /userdata/local/apps/ (installed
# apps); /usr/share/face-analysis/ is neither, so the manifest and the integration docs
# have to be copied across or the app never appears.
#
# This manifest used to ship inside the supervisor package instead. That made
# the console advertise face-analysis on devices where it was not installed, with an
# Enable button that could only fail ("init script not found"). It travels with
# the application now, so the gallery lists exactly what is installed.
APPS_DIR=/userdata/local/apps
SHARE_DIR=/usr/share/face-analysis
mkdir -p "$APPS_DIR"
for f in face-analysis.json face-analysis.md face-analysis.zh.md; do
    if [ -f "$SHARE_DIR/$f" ]; then
        cp -f "$SHARE_DIR/$f" "$APPS_DIR/$f"
    else
        echo "WARNING: $SHARE_DIR/$f missing, not registered"
    fi
done
echo "App manifest installed: $APPS_DIR/face-analysis.json"

# Migration: remove the auto-start (S-prefixed) script from older package
# layouts. Gallery apps must NOT start at boot — only the supervisor's
# app_restore starts the single active application (K-prefix is skipped
# by SysVinit but still invocable by path).
rm -f /etc/init.d/S92face-analysis

exit 0
